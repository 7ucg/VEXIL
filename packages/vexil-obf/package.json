{
  "name": "vexil-obf",
  "version": "1.0.0",
  "description": "JS/Dart obfuscator — identifier renaming, control-flow flattening, string encryption, and novel VEXIL-VM bytecode protection",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./rollup-plugin": "./dist/rollup-plugin.js",
    "./vite-plugin": "./dist/vite-plugin.js",
    "./webpack-plugin": "./dist/webpack-plugin.js",
    "./bundle": "./dist/bundle.js",
    "./esbuild-plugin": "./dist/esbuild-plugin.js"
  },
  "bin": {
    "vexil-obf": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:wasm": "cd ../../crates/vexil-obf-wasm && wasm-pack build --target nodejs --out-dir ../../packages/vexil-obf/wasm",
    "dev": "tsc --watch",
    "test": "node bench.js"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/generator": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/plugin-transform-arrow-functions": "^8.0.1",
    "@babel/plugin-transform-async-to-generator": "^8.0.1",
    "@babel/plugin-transform-classes": "^8.0.1",
    "@babel/plugin-transform-destructuring": "^8.0.1",
    "@babel/plugin-transform-regenerator": "^8.0.2",
    "@babel/plugin-transform-template-literals": "^8.0.1",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "commander": "^12.0.0"
  },
  "peerDependencies": {
    "esbuild": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "esbuild": { "optional": true }
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist/",
    "wasm/"
  ]
}
