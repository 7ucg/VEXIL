/target
**/target/
debug/
*.rs.bk
*.pdb

# Cargo: keep the workspace lock (binaries/FFI), drop the fuzz sub-crate lock
/fuzz/Cargo.lock

# Fuzzing artifacts (keep targets + corpus seeds in git if you add them)
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/

# graphify knowledge-graph output (regenerated, not source)
/graphify-out/

